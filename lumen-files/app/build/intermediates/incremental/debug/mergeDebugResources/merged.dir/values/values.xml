    <style name="ActionButton">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/lumenAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="AppDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_secondary</item>
        <item name="android:windowMinWidthMinor">82%</item>
    </style>
    <style name="AppDialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_secondary</item>
        <item name="android:windowMinWidthMinor">82%</item>
    </style>
