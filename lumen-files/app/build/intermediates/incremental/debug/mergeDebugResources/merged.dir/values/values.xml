    <style name="DialogTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="LumenSwitch">
        <item name="android:thumb">@drawable/toggle_thumb</item>
        <item name="android:track">@drawable/toggle_track</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:showText">false</item>
    </style>
    <style name="SectionTitle">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/lumenSecondary</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
    <style name="SheetDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
    <style name="ToolbarTitle">
