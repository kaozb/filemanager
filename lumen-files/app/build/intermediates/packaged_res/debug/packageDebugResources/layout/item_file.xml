<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="11dp"
    android:paddingEnd="10dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_check_off"
        android:contentDescription="@null"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="?attr/lumenOnAccent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_container"
        android:contentDescription="@null"
        android:padding="11dp"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="?attr/lumenText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?attr/lumenSecondary"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron"
        android:tint="?attr/lumenSecondary" />

</LinearLayout>
