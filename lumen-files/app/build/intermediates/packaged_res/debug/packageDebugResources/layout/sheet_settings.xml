<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheetScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_grip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置与 WebDAV"
                android:textColor="?attr/lumenText"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/sheetClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                android:tint="?attr/lumenSecondary" />

        </LinearLayout>

        <!-- 存储 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_container"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_storage"
                    android:tint="?attr/lumenAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="内部存储"
                        android:textColor="?attr/lumenText"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/storageSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="?attr/lumenSecondary"
                        android:textSize="10.5sp" />

                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/storageBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressBackgroundTint="?attr/lumenDivider"
                android:progressTint="?attr/lumenAccent" />

        </LinearLayout>

        <!-- 权限提示（无权限时显示） -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/lumenAccentContainer"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shield"
                android:tint="?attr/lumenAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="需要所有文件访问权限"
                    android:textColor="?attr/lumenText"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="开启后才能浏览和管理本机全部文件"
                    android:textColor="?attr/lumenSecondary"
                    android:textSize="10.5sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/grantBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tonal"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="授权"
                android:textColor="?attr/lumenOnAccentContainer"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WEBDAV 服务器" />

        <LinearLayout
            android:id="@+id/serversBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/addServerBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_add_server"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="＋ 添加 WebDAV 服务器"
            android:textColor="?attr/lumenAccent"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="快捷访问" />

        <GridLayout
            android:id="@+id/quickGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="偏好" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pref_dark"
                android:textColor="?attr/lumenText"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/prefDark"
                style="@style/LumenSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pref_hidden"
                android:textColor="?attr/lumenText"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/prefHidden"
                style="@style/LumenSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSizeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pref_row_size"
                android:textColor="?attr/lumenText"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/rowSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:text="标准"
                android:textColor="?attr/lumenSecondary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sortRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pref_sort"
                android:textColor="?attr/lumenText"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/sortValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:text="按名称"
                android:textColor="?attr/lumenSecondary"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="提示：在文件列表上双指开合，可以快速缩放列表行大小"
            android:textColor="?attr/lumenSecondary"
            android:textSize="10.5sp" />

    </LinearLayout>

</ScrollView>
