<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/lumenBg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/lumenSurface">

        <com.lumen.files.CrumbBar
            android:id="@+id/crumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="48dp" />

        <include layout="@layout/bar_selection" />

    </android.widget.Toolbar>

    <!-- 面板指示点：左右滑动切换两个面板；上滑此区域打开设置 -->
    <LinearLayout
        android:id="@+id/gestureBar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="?attr/lumenSurface"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotFirst"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot" />

        <View
            android:id="@+id/dotSecond"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_dot" />

    </LinearLayout>

    <com.lumen.files.PanePager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/paneLeft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/paneRight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

    </com.lumen.files.PanePager>

</LinearLayout>
