<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="名称"
            android:textColor="?attr/lumenSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：我的 NAS"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/lumenText"
            android:textColorHint="?attr/lumenSecondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="服务器地址"
            android:textColor="?attr/lumenSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://dav.example.com/dav/"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="?attr/lumenText"
            android:textColorHint="?attr/lumenSecondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="用户名"
            android:textColor="?attr/lumenSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="可留空"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/lumenText"
            android:textColorHint="?attr/lumenSecondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="密码"
            android:textColor="?attr/lumenSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="可留空"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="?attr/lumenText"
            android:textColorHint="?attr/lumenSecondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="支持 HTTPS 与 Basic 认证。地址需指向 WebDAV 根目录，建议以 / 结尾。"
            android:textColor="?attr/lumenSecondary"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
