<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="lumenBg">@color/light_bg</item>
        <item name="lumenSurface">@color/light_surface</item>
        <item name="lumenContainer">@color/light_container</item>
        <item name="lumenCard">@color/light_card</item>
        <item name="lumenText">@color/light_text</item>
        <item name="lumenSecondary">@color/light_secondary</item>
        <item name="lumenDivider">@color/light_divider</item>
        <item name="lumenAccent">@color/light_accent</item>
        <item name="lumenOnAccent">@color/light_on_accent</item>
        <item name="lumenAccentContainer">@color/light_accent_container</item>
        <item name="lumenOnAccentContainer">@color/light_on_accent_container</item>
        <item name="lumenAccent2">@color/light_accent2</item>
        <item name="lumenRipple">@color/light_ripple</item>
        <item name="lumenDanger">@color/light_danger</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_secondary</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog.Light</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="lumenBg">@color/dark_bg</item>
        <item name="lumenSurface">@color/dark_surface</item>
        <item name="lumenContainer">@color/dark_container</item>
        <item name="lumenCard">@color/dark_card</item>
        <item name="lumenText">@color/dark_text</item>
        <item name="lumenSecondary">@color/dark_secondary</item>
        <item name="lumenDivider">@color/dark_divider</item>
        <item name="lumenAccent">@color/dark_accent</item>
        <item name="lumenOnAccent">@color/dark_on_accent</item>
        <item name="lumenAccentContainer">@color/dark_accent_container</item>
        <item name="lumenOnAccentContainer">@color/dark_on_accent_container</item>
        <item name="lumenAccent2">@color/dark_accent2</item>
        <item name="lumenRipple">@color/dark_ripple</item>
        <item name="lumenDanger">@color/dark_danger</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_secondary</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/AppDialog.Dark</item>
    </style>

    <!-- 圆角 22dp 对话框 -->
    <style name="AppDialog.Light" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_secondary</item>
        <item name="android:windowMinWidthMinor">82%</item>
    </style>

    <style name="AppDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_secondary</item>
        <item name="android:windowMinWidthMinor">82%</item>
    </style>

    <style name="DialogTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 底部悬浮设置面板 -->
    <style name="SheetDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- 居中弹出菜单（长按文件/文件夹） -->
    <style name="CenterMenuDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/CenterMenuAnim</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
    </style>

    <style name="CenterMenuAnim">
        <item name="android:windowEnterAnimation">@anim/menu_in</item>
        <item name="android:windowExitAnimation">@anim/menu_out</item>
    </style>

    <style name="ToolbarTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/lumenSecondary</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ActionButton">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/lumenAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="LumenSwitch">
        <item name="android:thumb">@drawable/toggle_thumb</item>
        <item name="android:track">@drawable/toggle_track</item>
        <item name="android:switchMinWidth">44dp</item>
        <item name="android:showText">false</item>
    </style>

</resources>
