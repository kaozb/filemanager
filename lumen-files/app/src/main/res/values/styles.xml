<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="lumenBg">@color/light_bg</item>
        <item name="lumenSurface">@color/light_surface</item>
        <item name="lumenCard">@color/light_card</item>
        <item name="lumenText">@color/light_text</item>
        <item name="lumenSecondary">@color/light_secondary</item>
        <item name="lumenDivider">@color/light_divider</item>
        <item name="lumenAccent">@color/light_accent</item>
        <item name="lumenAccent2">@color/light_accent2</item>
        <item name="lumenRipple">@color/light_ripple</item>
        <item name="android:colorAccent">@color/light_accent</item>
        <item name="android:textColorPrimary">@color/light_text</item>
        <item name="android:textColorSecondary">@color/light_secondary</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_status</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="lumenBg">@color/dark_bg</item>
        <item name="lumenSurface">@color/dark_surface</item>
        <item name="lumenCard">@color/dark_card</item>
        <item name="lumenText">@color/dark_text</item>
        <item name="lumenSecondary">@color/dark_secondary</item>
        <item name="lumenDivider">@color/dark_divider</item>
        <item name="lumenAccent">@color/dark_accent</item>
        <item name="lumenAccent2">@color/dark_accent2</item>
        <item name="lumenRipple">@color/dark_ripple</item>
        <item name="android:colorAccent">@color/dark_accent</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_secondary</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_status</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/lumenSecondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ActionButton">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/lumenAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

</resources>
